<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />   <!-- already there -->
    <uses-permission android:name="android.permission.INTERNET" />        <!-- ADD this -->


    <!-- Android 11+ package visibility: lets us check whether a speech
         recognition service (e.g. Google's) exists on the device -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:usesCleartextTraffic="true"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="EnodaAI"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.EnodaAI">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.EnodaAI">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
